# Supabase (Settings > API no painel do projeto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Usada para registrar execuções e receber webhooks/callbacks.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública desta aplicação (usada no callback enviado ao n8n e nas URLs de webhook)
APP_URL=http://localhost:3000

# n8n
N8N_BASE_URL=
# Segredo enviado pela plataforma ao n8n no cabeçalho x-orvex-secret
N8N_WEBHOOK_SECRET=
# Segredo que o n8n envia no cabeçalho x-orvex-secret ao chamar /api/n8n/callback
N8N_CALLBACK_SECRET=
# Opcional: valida a API do n8n na página de Integrações
N8N_API_KEY=

# Provedor de IA (openai | anthropic). AI_BASE_URL é opcional para APIs compatíveis com OpenAI.
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=

# Permite testar APIs em endereços locais/privados (apenas desenvolvimento)
ALLOW_PRIVATE_API_URLS=false
